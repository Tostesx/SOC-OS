#!/usr/bin/env bash
set -euo pipefail

SOC_HOME="${HOME}/.soc"
SOC_LOG="${SOC_HOME}/log"
mkdir -p "$SOC_HOME"

RST=$'\e[0m'; FG=$'\e[32m'; DIM=$'\e[2m'; HL=$'\e[7m'

log() { printf '[%s] %s\n' "$(date -Iseconds)" "$*" >> "$SOC_LOG"; }
pausa() { read -rp "Enter para voltar... " _; }

# --- INÍCIO DA LOGO E ANIMAÇÃO ---
SOC_LOGO=(
"                       ##                       "
"                      +++#                      "
"                      #+++                      "
"                     #++++#                     "
"                    #++++++#                    "
"                    #+++++++-                   "
"                 #####++++#+##                  "
"                #+##+#+#####++#+                "
"             ##+++###+####+#+#++#               "
"            ##+###+++++++##+##++++#             "
"       ##+++#+++###++#+###++#+##+++#++###       "
" ###+++++++++#+++####++#####+###++#+++++++++##+ "
"     ###+++++###++###########++++#++++++##      "
"          +#+++###+++#+++++++##+#++#+           "
"            #++##++++###+++###+#+++##           "
"              ##+#+++++####+#####+              "
"                   #+++++++++                   "
"                    #++++++#                    "
"                     #++++#                     "
"                      #+++                      "
"                      #++#                      "
"                       ##                       "
"                        #                       "
)

animar_logo() {
    clear
    printf '%s' "$FG"
    local cols=$(tput cols 2>/dev/null || echo 80)
    local pad=$(( (cols - 48) / 2 ))
    if [[ $pad -lt 0 ]]; then pad=0; fi
    local pad_str=$(printf "%${pad}s" "")

    for line in "${SOC_LOGO[@]}"; do
        printf "%s%s\n" "$pad_str" "$line"
        sleep 0.04
    done
    sleep 0.5
}
# --- FIM DA LOGO E ANIMAÇÃO ---

header() {
    clear
    printf '%s' "$FG"
    # Centraliza a caixa do cabeçalho
    local cols=$(tput cols 2>/dev/null || echo 80)
    local pad=$(( (cols - 45) / 2 ))
    if [[ $pad -lt 0 ]]; then pad=0; fi
    local pad_str=$(printf "%${pad}s" "")
    
    cat <<EOF
${pad_str}┌─────────────────────────────────────────────┐
${pad_str}│  SOC — SISTEMA OPERACIONAL DE CONTROLE      │
${pad_str}│  v0.2 · TTY · INDUSTRIAL                    │
${pad_str}└─────────────────────────────────────────────┘
EOF
}

menu() {
    local sel=$1
    local -a itens=(
        "1  Desenvolvedor"
        "2  Industrial"
        "3  Navegador Web"
        "4  Internet        (cabo / wifi / autoconectar)"
        "5  IntraChat       (mensagens na LAN)"
        "6  Arquivos        (/home)"
        "7  Bash Livre"
        "8  Sistema         (temp / disco / atualizacoes)"
        "0  Energia         (desligar / reiniciar / suspender)"
    )
    
    # Centraliza o menu baseado na largura do terminal
    local cols=$(tput cols 2>/dev/null || echo 80)
    local block_width=52
    local pad=$(( (cols - block_width) / 2 ))
    if [[ $pad -lt 0 ]]; then pad=0; fi
    local pad_str=$(printf "%${pad}s" "")

    for i in "${itens[@]}"; do
        if [[ "${i:0:1}" == "$sel" ]]; then
            printf '%s%s ▶ %s %s\n' "$pad_str" "$HL" "$i" "$RST"
        else
            printf '%s   %s \n' "$pad_str" "$i"
        fi
    done
}

confirmar() {
    printf '%s%s [s/N]: %s' "$FG" "$1" "$RST"
    read -rn1 r; echo
    [[ $r =~ ^[sSyY]$ ]]
}

ferramenta() {
    if command -v "$1" &>/dev/null; then "$@"
    else printf 'Ferramenta ausente: %s\n' "$1"; fi
    pausa
}

web() {
    clear
    echo "╔═════════════════════════════════════════════╗"
    echo "║               NAVEGADOR SOC                 ║"
    echo "╚═════════════════════════════════════════════╝"
    echo "  (Dica: Use Ctrl+K a qualquer momento para sair)"

    # 1. BARRA DE URL E BUSCA INTELIGENTE
    echo ""
    echo -n "  [ URL / BUSCA ] > "
    read -r entrada

    [[ -z "$entrada" ]] && return

    # Se a entrada tiver espaços ou não tiver um ponto, é uma busca.
    # Usamos o DuckDuckGo HTML que funciona perfeitamente no terminal.
    if [[ "$entrada" == *" "* || "$entrada" != *.* ]]; then
        echo "  Buscando por: $entrada"
        # Transforma espaços em '+'
        query="${entrada// /+}"
        url="https://html.duckduckgo.com/html/?q=$query"
    else
        # É um site direto. Se não tiver http, adiciona.
        if [[ "$entrada" != http* ]]; then
            url="https://$entrada"
        else
            url="$entrada"
        fi
    fi

    # 2. PROCESSAMENTO (Mostra o título da página)
    echo ""
    echo -n "  Carregando..."
    title=$(curl -sL --max-time 5 "$url" | grep -oP '(?<=<title>).*?(?=</title>)' | head -1)
    echo -e "\r  Página: ${title:-Desconhecida ou Sem Título}                    "
    echo ""

    # 3. MENU DE AÇÕES (Meio)
    local opcoes=(
        "📄 Ler a página (Texto puro via w3m)"
        "🔗 Extrair Links da página"
        "🖼️  Ver Imagens desta página"
        "🎬 Ver Vídeos desta página"
        "🔍 Fazer nova busca / digitar outra URL"
        "🚪 Sair para o Bash"
    )

    local escolha
    escolha=$(printf "%s\n" "${opcoes[@]}" | fzf --height=12 --prompt="  Ação > " --reverse --header="  [ MENU DE AÇÕES ]" --bind 'ctrl-k:abort,esc:abort')

    # Se o usuário apertar ESC, Ctrl+K ou escolher sair
    if [[ -z "$escolha" || "$escolha" == *"Sair"* ]]; then
        return
    fi

    # 4. EXECUÇÃO
    case "$escolha" in
        *"Ler a página"*)
            w3m "$url"
            ;;
        *"Extrair Links"*)
            clear
            echo "  Extraindo links de $url ..."
            local links
            links=$(curl -sL "$url" | grep -oP 'href="\K[^"]+' | grep -E '^https?://' | sort -u | head -30)

            if [[ -z "$links" ]]; then
                echo "  Nenhum link externo encontrado."
            else
                local link_escolhido
                link_escolhido=$(echo "$links" | fzf --height=15 --prompt="  Link > " --reverse --bind 'ctrl-k:abort,esc:abort')
                if [[ -n "$link_escolhido" ]]; then
                    # Abre o link escolhido no w3m
                    w3m "$link_escolhido"
                fi
            fi
            ;;
        *"Ver Imagens"*)
            clear
            echo "  Extraindo imagens da página..."
            local imgs
            imgs=$(curl -sL --max-time 5 "$url" | grep -oP 'https?://[^"'"'"']+\.(jpg|jpeg|png|gif|webp)' | sort -u | head -20)

            if [[ -z "$imgs" ]]; then
                echo "  Nenhuma imagem direta encontrada."
            else
                local img_escolhida
                img_escolhida=$(echo "$imgs" | fzf --height=12 --prompt="  Imagem > " --reverse --bind 'ctrl-k:abort,esc:abort')
                if [[ -n "$img_escolhida" ]]; then
                    clear
                    echo "  Renderizando imagem (Ctrl+K para sair)..."
                    curl -sL --max-time 5 "$img_escolhida" | chafa -f symbols --size=80x40 -
                fi
            fi
            ;;
        *"Ver Vídeos"*)
            clear
            echo "  Procurando vídeos diretos..."
            local vids
            vids=$(curl -sL --max-time 5 "$url" | grep -oP 'https?://[^"'"'"']+\.(mp4|webm|mkv)' | sort -u)

            if [[ -z "$vids" ]]; then
                echo "  Nenhum vídeo direto (mp4/webm) encontrado. (Sites como YouTube usam players dinâmicos)."
            else
                local vid_escolhido
                vid_escolhido=$(echo "$vids" | fzf --height=12 --prompt="  Vídeo > " --reverse --bind 'ctrl-k:abort,esc:abort')
                if [[ -n "$vid_escolhido" ]]; then
                    clear
                    echo "  Reproduzindo vídeo (Ctrl+K para sair)..."
                    mpv --vo=tct "$vid_escolhido" 2>/dev/null || echo "Falha ao reproduzir."
                fi
            fi
            ;;
        *"Fazer nova busca"*)
            web # Chama a função novamente para reiniciar
            return
            ;;
    esac

    pausa
}

internet() {
    while true; do
        clear
        echo "── INTERNET ──"
        nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null | sed 's/^/    /'
        echo
        echo "  1) Conectar / trocar rede"
        echo "  2) Editar conexoes"
        echo "  3) Ativar / desativar wifi"
        echo "  4) Autoconectar (on/off)"
        echo "  0) Voltar"
        read -rsn1 o; echo
        case $o in
            1) nmtui-connect ;;
            2) nmtui-edit ;;
            3) est=$(nmcli radio wifi)
               if [[ $est == enabled ]]; then nmcli radio wifi off; else nmcli radio wifi on; fi
               log "internet: wifi -> $(nmcli radio wifi)" ;;
            4) autoconnect_menu ;;
            0) return ;;
        esac
    done
}

autoconnect_menu() {
    mapfile -t conns < <(nmcli -t -f NAME,TYPE connection show | grep -v '^lo:')
    if (( ${#conns[@]} == 0 )); then echo "Nenhuma conexao salva."; pausa; return; fi
    PS3="Conexao: "
    select c in "${conns[@]}" "Voltar"; do
        [[ $c == Voltar || -z $c ]] && return
        nome="${c%%:*}"
        atual=$(nmcli -g connection.autoconnect connection show "$nome")
        if [[ $atual == yes ]]; then
            nmcli connection modify "$nome" connection.autoconnect no
            echo "'$nome' NAO autoconecta mais."
        else
            nmcli connection modify "$nome" connection.autoconnect yes
            echo "'$nome' VAI autoconectar."
        fi
        log "internet: autoconnect '$nome' = $(nmcli -g connection.autoconnect connection show "$nome")"
        pausa; return
    done
}

intrachat() {
    clear
    echo "── INTRACHAT (LAN) ──"
    if command -v avahi-browse &>/dev/null; then
        echo "  Pares na rede:"
        timeout 2 avahi-browse -at 2>/dev/null | grep -i irc | sed 's/^/    /' || true
        echo
    fi
    echo "  1) Abrir cliente (weechat)"
    echo "  2) Iniciar servidor local (ngircd)"
    echo "  3) Chat P2P (soc-chat, se instalado)"
    echo "  0) Voltar"
    read -rsn1 o; echo
    case $o in
        1) weechat ;;
        2) sudo systemctl enable --now ngircd && echo "ngircd ativo" && pausa ;;
        3) if command -v soc-chat &>/dev/null; then soc-chat; else echo "soc-chat nao instalado."; pausa; fi ;;
        0) return ;;
    esac
}

industrial() {
    clear
    echo "── INDUSTRIAL ──"
    echo "  1) arduino-cli version"
    echo "  2) cobc --version (GnuCOBOL)"
    echo "  3) beremiz (GUI, requer X)"
    echo "  0) Voltar"
    read -rsn1 o; echo
    case $o in
        1) arduino-cli version 2>/dev/null || echo "nao instalado" ;;
        2) cobc --version       2>/dev/null || echo "nao instalado" ;;
        3) echo "Beremiz exige ambiente grafico." ;;
        0) return ;;
    esac
    pausa
}

sistema() {
    while true; do
        clear
        echo "── SISTEMA ──"
        echo "  1) Temperatura"
        echo "  2) Espaco de RAM e Disco"
        echo "  3) Atualizacoes (pacman -Syu)"
        echo "  4) Atualizacoes automaticas (on/off)"
        echo "  0) Voltar"
        read -rsn1 o; echo
        case $o in
            1) sensors 2>/dev/null || echo "lm-sensors: rode 'sudo sensors-detect'"; pausa ;;
            2)  clear
               printf '%s── MEMÓRIA RAM ──%s\n' "$FG" "$RST"
               free -h
               echo ""
               printf '%s── ESPAÇO EM DISCO ──%s\n' "$FG" "$RST"
               df -h / /home 2>/dev/null
               pausa
               ;;
            3) sudo pacman -Syu; pausa ;;
            4) auto_updates ;;
            0) return ;;
        esac
    done
}

auto_updates() {
    local unit="soc-updates.timer"
    if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
        sudo systemctl disable --now "$unit"
        echo "Atualizacoes automaticas DESATIVADAS."
    else
        if sudo systemctl enable --now "$unit" 2>/dev/null; then
            echo "Atualizacoes automaticas ATIVADAS."
        else
            echo "Timer $unit nao encontrado."
        fi
    fi
    log "sistema: auto-updates -> $(systemctl is-enabled "$unit" 2>/dev/null || echo off)"
    pausa
}

energia() {
    while true; do
        clear
        echo "── ENERGIA ──"
        echo "  1) Desligar"
        echo "  2) Reiniciar"
        echo "  3) Suspender"
        echo "  0) Voltar"
        read -rsn1 o; echo
        case $o in
            1) confirmar "Desligar o SOC?"   && { log "energia: poweroff"; sudo systemctl poweroff; } ;;
            2) confirmar "Reiniciar o SOC?"  && { log "energia: reboot";   sudo systemctl reboot; } ;;
            3) confirmar "Suspender o SOC?"  && { log "energia: suspend";  sudo systemctl suspend; } ;;
            0) return ;;
        esac
    done
}

acao() {
    case "$1" in
        1) log "menu:dev";        ferramenta vim ;;
        2) log "menu:industrial"; industrial ;;
        3) log "menu:web";        web ;;
        4) log "menu:internet";   internet ;;
        5) log "menu:intrachat";  intrachat ;;
        6) log "menu:arquivos";   ( cd "$HOME" && bash ) ;;
        7) log "menu:bash";       bash ;;
        8) log "menu:sistema";    sistema ;;
        0) log "menu:energia";    energia ;;
    esac
}

# --- NOVO: Lógica de inicialização com Splash Screen ---
# Se a variável SOC_BOOTED não existir, mostra a animação.
if [[ -z "${SOC_BOOTED:-}" ]]; then
    animar_logo
    export SOC_BOOTED=1
fi

sel=""
while true; do
    header
    menu "$sel"
    
    # Centraliza o texto "Selecione"
    local cols=$(tput cols 2>/dev/null || echo 80)
    local pad=$(( (cols - 52) / 2 ))
    if [[ $pad -lt 0 ]]; then pad=0; fi
    local pad_str=$(printf "%${pad}s" "")
    
    printf '\n%s%sSelecione [0-9]: %s' "$pad_str" "$DIM" "$RST"
    read -rsn1 sel
    [[ -z "$sel" ]] && continue
    acao "$sel"
done
